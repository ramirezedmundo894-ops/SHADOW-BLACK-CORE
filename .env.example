# Local development only; replace before use and never reuse in deployed environments.
SHADOW_POSTGRES_PASSWORD=local-only-change-this-password
SHADOW_GO_INTERNAL_TOKEN=local-only-change-this-token-to-at-least-32-characters
SHADOW_CORE_JWT_SECRET=replace-with-random-32-byte-or-longer-secret
SHADOW_CORE_ISSUER_TOKEN=replace-with-random-32-byte-or-longer-issuer-secret
SHADOW_GO_PROXY_TOKEN=replace-with-a-distinct-random-proxy-token
