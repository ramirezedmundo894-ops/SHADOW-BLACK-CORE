# Terraform configuration is intentionally a non-production starter.
# Review every resource, identity, network rule, and cost before applying.
terraform {
  required_version = ">= 1.5.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}
